# Nakili faili hili kwenda ".env" kwa majaribio ya kompyuta yako tu.
# Kwenye hosting (Render/Railway), weka thamani hizi kwenye "Environment Variables" badala yake.
# USIPAKIE .env kwenye GitHub.

# 1. Groq key. Pata kwenye https://console.groq.com/keys (inaanza na gsk_)
GROQ_API_KEY=

# 2. Token ya app. Angalau herufi 16. Weka THAMANI HII HII kwenye app, kwenye AI > Mipangilio ya seva.
#    Tengeneza kwa: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_TOKEN=

# 3. Asili za browser zinazoruhusiwa. "*" inaruhusu app/PWA/APK yoyote, lakini token bado inalinda.
#    Ukitaka kuzuia, weka domain yako, mfano: https://jina.github.io,https://pos.example.com
ALLOWED_ORIGINS=*

# 4. Model ya Groq (hiari). Kama Groq itaiondoa, badilisha hapa.
GROQ_MODEL=llama-3.3-70b-versatile

# 5. Maombi kwa dakika kwa kila mtumiaji (hiari)
RATE_LIMIT_PER_MIN=30
